rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Moderator accounts. Create these users in Firebase Auth first,
    // then list their emails here. They can moderate the wall AND run the game.
    function isMod() {
      return request.auth != null
        && request.auth.token.email in [
          'mburleson@omag.org',
          'rmann@omag.org'
        ];
    }

    function validPhoto(d) {
      return !('image' in d)
        || (d.image is string
            && d.image.size() < 900000
            && d.image.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+'));
    }

    // ── Expo Wall ──────────────────────────────────────────────

    // Attendee submissions. Anyone can create a pending post; only
    // moderators can read or change them. A post needs text, a photo, or both.
    match /posts/{postId} {
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'org', 'message', 'image', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 200
        && (request.resource.data.message.size() > 0 || 'image' in request.resource.data)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.org is string
        && request.resource.data.org.size() <= 60
        && validPhoto(request.resource.data);
      allow read, update, delete: if isMod();
    }

    // Approved posts. Public read for the display; moderator write only.
    match /wall/{postId} {
      allow read: if true;
      allow write: if isMod();
    }

    // ── What Lies Beneath game ─────────────────────────────────
    // Players sign in anonymously; the admin page uses a moderator login above.
    function isGameHost() {
      return isMod();
    }

    function validName(n) {
      return n is string && n.size() >= 2 && n.size() <= 24;
    }

    function gameDoc(gameId) {
      return get(/databases/$(database)/documents/games/$(gameId)).data;
    }

    // Answers only land while that exact question is open and on the clock
    // (+2s grace for phone latency). Once the host reveals, it's closed.
    function questionOpen(gameId, q) {
      let g = gameDoc(gameId);
      return g.phase == 'question'
        && g.qIndex == q
        && request.time < g.openedAt + duration.value(g.timeLimit + 2, 's');
    }

    match /games/{gameId} {
      allow read: if true;
      allow write: if isGameHost();

      match /players/{uid} {
        allow read: if true;

        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'team', 'score', 'correct', 'answered', 'streak', 'joinedAt'])
          && validName(request.resource.data.name)
          && request.resource.data.team is string && request.resource.data.team.size() <= 40
          && request.resource.data.score == 0
          && request.resource.data.correct == 0
          && request.resource.data.answered == 0
          && request.resource.data.streak == 0
          && request.resource.data.joinedAt == request.time;

        // Players can fix their name/team only while the game is in the lobby.
        // Scores are written by the host alone.
        allow update: if isGameHost()
          || (request.auth != null && request.auth.uid == uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'team'])
              && validName(request.resource.data.name)
              && request.resource.data.team is string && request.resource.data.team.size() <= 40
              && (!exists(/databases/$(database)/documents/games/$(gameId)) || gameDoc(gameId).phase == 'lobby'));

        allow delete: if isGameHost();
      }

      // The screen notes when a video ends so the admin page can open the first question.
      match /signals/{sigId} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.resource.data.keys().hasOnly(['q', 'at'])
          && request.resource.data.q is int
          && sigId == 'video-' + string(request.resource.data.q)
          && request.resource.data.at == request.time
          && gameDoc(gameId).phase == 'video'
          && gameDoc(gameId).qIndex == request.resource.data.q;
        allow delete: if isGameHost();
      }

      // One answer per player per question (create-only, id = uid_q).
      match /answers/{answerId} {
        allow read: if true;

        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'q', 'picks', 'name', 'team', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.q is int
          && answerId == request.auth.uid + '_' + string(request.resource.data.q)
          && request.resource.data.picks is list
          && request.resource.data.picks.size() >= 1 && request.resource.data.picks.size() <= 8
          && request.resource.data.at == request.time
          && exists(/databases/$(database)/documents/games/$(gameId)/players/$(request.auth.uid))
          && questionOpen(gameId, request.resource.data.q);

        allow update, delete: if isGameHost();
      }
    }
  }
}
